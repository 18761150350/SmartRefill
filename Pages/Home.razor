@page "/"

<PageTitle>智能补货计算系统</PageTitle>

<div class="home-container">
    <!-- 主标题区域 -->
    <div class="hero-section">
        <div class="hero-content">
            <div class="hero-icon">🚀</div>
            <h1 class="hero-title">智能补货计算系统</h1>
            <p class="hero-subtitle">高效、准确的自动化补货解决方案</p>
        </div>
    </div>

    <!-- 功能卡片区域 -->
    <div class="features-section">
        <div class="features-grid">
            <!-- Excel文件处理 -->
            <div class="feature-card">
                <div class="feature-icon">📁</div>
                <h3 class="feature-title">Excel文件处理</h3>
                <p class="feature-description">支持交易记录和补货历史文件上传，自动解析数据</p>
            </div>

            <!-- 智能分析 -->
            <div class="feature-card">
                <div class="feature-icon">🔍</div>
                <h3 class="feature-title">智能分析</h3>
                <p class="feature-description">自动检测机器信息，分析销售数据和补货需求</p>
            </div>

            <!-- 精准计算 -->
            <div class="feature-card">
                <div class="feature-icon">📊</div>
                <h3 class="feature-title">精准计算</h3>
                <p class="feature-description">基于历史数据和智能算法，计算最优补货量</p>
            </div>

            <!-- 结果导出 -->
            <div class="feature-card">
                <div class="feature-icon">💾</div>
                <h3 class="feature-title">结果导出</h3>
                <p class="feature-description">一键导出计算结果，支持复制和CSV格式</p>
            </div>
        </div>
    </div>

    <!-- 开始使用按钮 -->
    <div class="action-section">
        <a href="/smart-refill" class="start-button">
            开始使用智能补货 →
        </a>
    </div>
</div> 